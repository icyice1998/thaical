# Copy to env.local (Linux/macOS/cloud) and fill in. Never commit the real file.
# Use a READ-ONLY database user.

DB_HOST=0.tcp.ngrok.io      # or 127.0.0.1 if running on the same machine as MySQL
DB_PORT=12345               # ngrok TCP port, or 3306 locally
DB_NAME=drgstr
DB_USER=readonly
DB_PASS=

# Thai 4.0 data is usually TIS620. If names come out garbled, try latin1 then UTF-8.
DB_CHARSET=TIS620

# Extra raw JDBC params if ever needed, e.g. jdbcCompliantTruncation=false
# DB_PARAMS=

# OUT_DIR=../../data   # where products.json + stock.json are written (default: this folder)
