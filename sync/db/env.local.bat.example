@echo off
REM Copy to env.local.bat (Windows, on the shop PC) and fill in. Never commit the real file.
REM Use a READ-ONLY database user.

set DB_HOST=127.0.0.1
set DB_PORT=3306
set DB_NAME=drgstr
set DB_USER=readonly
set DB_PASS=

REM Thai 4.0 data is usually TIS620. If names come out garbled, try latin1 then UTF-8.
set DB_CHARSET=TIS620

REM set DB_PARAMS=jdbcCompliantTruncation=false

REM set OUT_DIR=..\..\data   REM where products.json + stock.json are written (default: this folder)
